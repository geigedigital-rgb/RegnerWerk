# Mapbox public token (pk.*) — required for map tiles + address search.
# Token URL restrictions must list the exact origins (no trailing slash):
#   http://localhost:3002
#   https://<configurator>.up.railway.app
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin/API (CRM + project save). NEVER the configurator URL (causes a proxy loop).
# Used server-side by /api/lead and /api/projects/* proxy. Local: http://localhost:3001
BACKEND_URL=http://localhost:3001
# Optional fallback — also must be the admin backend, not :3002 / konfigurator.regnerwerk.de
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional — same value as Backend PROJECTS_SUBMIT_TOKEN (server-only preferred)
PROJECTS_SUBMIT_TOKEN=

# Marketing website (primary domain) — Beratung CTAs from configurator
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram inbound leads (server-only — never NEXT_PUBLIC)
# Bot token + numeric chat id of the inbox
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
