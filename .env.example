# Mapbox public token (pk.*) — required for map tiles + address search.
# Token URL restrictions must list the exact origins (no trailing slash):
#   http://localhost:3002
#   https://<configurator>.up.railway.app
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin/API (CRM + project save). NOT the configurator URL.
# Local: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side CRM (PDF lead fallback). Same origin as the admin backend.
BACKEND_URL=http://localhost:3001
# Optional — only if Backend PROJECTS_SUBMIT_TOKEN is set to the same value
NEXT_PUBLIC_PROJECTS_SUBMIT_TOKEN=

# Marketing website (primary domain) — Beratung CTAs from configurator
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram inbound leads (server-only — never NEXT_PUBLIC)
# Bot token + numeric chat id of the inbox
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
