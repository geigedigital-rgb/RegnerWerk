# Mapbox public token (pk.*) — required for map tiles + address search.
# In Mapbox → Tokens: enable Geocoding. If URL restrictions are on, allow:
#   http://localhost:3002
#   https://*.up.railway.app
NEXT_PUBLIC_MAPBOX_TOKEN=

# RegnerWerk Backend (projects API) — admin/API, typically port 3001 locally
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional — only if Backend PROJECTS_SUBMIT_TOKEN is set
NEXT_PUBLIC_PROJECTS_SUBMIT_TOKEN=

# Marketing website (primary domain) — Beratung CTAs from configurator
NEXT_PUBLIC_SITE_URL=http://localhost:3000
